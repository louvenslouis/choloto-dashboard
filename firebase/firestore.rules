rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /croix/{document} {
      allow create: if request.auth.uid == request.resource.data.created_by;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    match /user/{document} {
      allow create: if false;
      allow read: if false;
      allow write: if true;
      allow delete: if true;
    }

    match /resultats/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    match /prediction/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /bingo/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    match /bingo/{parent}/bingostats/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    match /{path=**}/bingostats/{document} {
      allow read: if true;
    }

  }
}
