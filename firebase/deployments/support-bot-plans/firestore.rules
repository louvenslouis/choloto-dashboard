rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Compatibility policy:
    // - Public reads used by released clients stay public.
    // - Legacy client-side writes stay available to authenticated users.
    // - Existing field names remain accepted, but malformed payloads are rejected.
    // This lets a future release move publisher writes behind an admin claim or
    // Cloud Function without breaking applications that are already installed.
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        (('admin' in request.auth.token) && request.auth.token.admin == true) ||
        (('email' in request.auth.token) &&
          request.auth.token.email == 'sanonmaeva064@gmail.com')
      );
    }

    function hasActiveVipAccess() {
      return signedIn() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/user/$(request.auth.uid)) &&
          ('end_sub' in get(
            /databases/$(database)/documents/user/$(request.auth.uid)
          ).data) &&
          get(
            /databases/$(database)/documents/user/$(request.auth.uid)
          ).data.end_sub is timestamp &&
          get(
            /databases/$(database)/documents/user/$(request.auth.uid)
          ).data.end_sub >= request.time
        )
      );
    }

    function owns(field) {
      return signedIn() && resource.data[field] == request.auth.uid;
    }

    function createsOwn(field) {
      return signedIn() && request.resource.data[field] == request.auth.uid;
    }

    function keepsOwner(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function optionalString(data, field, maxLength) {
      return !(field in data) ||
          (data[field] is string && data[field].size() <= maxLength);
    }

    function optionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function optionalInt(data, field) {
      return !(field in data) || data[field] is int;
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function optionalList(data, field, maxItems) {
      return !(field in data) ||
          (data[field] is list && data[field].size() <= maxItems);
    }

    function optionalMap(data, field) {
      return !(field in data) || data[field] is map;
    }

    function validCroix(data) {
      return data.keys().hasOnly(['date', 'created_by', 'numeros']) &&
          optionalTimestamp(data, 'date') &&
          optionalString(data, 'created_by', 128) &&
          optionalList(data, 'numeros', 32);
    }

    function validResultat(data) {
      return data.keys().hasOnly([
            'date', 'bingo', 'periode', 'tirage', 'created_by', 'numeros'
          ]) &&
          optionalTimestamp(data, 'date') &&
          optionalList(data, 'bingo', 32) &&
          optionalString(data, 'periode', 64) &&
          optionalString(data, 'tirage', 32) &&
          optionalString(data, 'created_by', 128) &&
          optionalList(data, 'numeros', 32);
    }

    function validPrediction(data) {
      return data.keys().hasOnly([
            'date',
            'periode',
            'pourcentage',
            'created_by',
            'starsRef',
            'boloto',
            'mariage',
            'chif3',
            'chif4',
            'favori',
            'soutni',
            'extra'
          ]) &&
          optionalTimestamp(data, 'date') &&
          optionalString(data, 'periode', 64) &&
          optionalInt(data, 'pourcentage') &&
          optionalString(data, 'created_by', 128) &&
          optionalMap(data, 'boloto') &&
          optionalMap(data, 'mariage') &&
          optionalMap(data, 'chif3') &&
          optionalMap(data, 'chif4') &&
          optionalMap(data, 'favori') &&
          optionalMap(data, 'soutni') &&
          optionalMap(data, 'extra');
    }

    function validBingo(data) {
      return data.keys().hasOnly(['date', 'dataStack', 'expiration']) &&
          optionalTimestamp(data, 'date') &&
          optionalList(data, 'dataStack', 32) &&
          optionalTimestamp(data, 'expiration');
    }

    function validBingoStats(data) {
      return data.keys().hasOnly(['user', 'gain']) &&
          optionalString(data, 'user', 128) &&
          optionalBool(data, 'gain');
    }

    function validBingoComment(data) {
      return data.keys().hasOnly([
            'user', 'text', 'createdAt', 'updatedAt',
            'adminLiked', 'adminLikedAt', 'adminLikedBy',
            'adminReply', 'adminReplyAt', 'adminReplyBy'
          ]) &&
          data.keys().hasAll(['user', 'text', 'createdAt', 'updatedAt']) &&
          data.user is string && data.user.size() <= 128 &&
          data.text is string && data.text.size() > 0 &&
          data.text.size() <= 500 &&
          data.createdAt is timestamp &&
          data.updatedAt is timestamp &&
          (
            (!('adminLiked' in data) &&
              !('adminLikedAt' in data) &&
              !('adminLikedBy' in data)) ||
            (data.adminLiked == true &&
              data.adminLikedAt is timestamp &&
              data.adminLikedBy is string &&
              data.adminLikedBy.size() > 0 &&
              data.adminLikedBy.size() <= 128)
          ) &&
          (
            (!('adminReply' in data) &&
              !('adminReplyAt' in data) &&
              !('adminReplyBy' in data)) ||
            (data.adminReply is string &&
              data.adminReply.size() > 0 &&
              data.adminReply.size() <= 500 &&
              data.adminReplyAt is timestamp &&
              data.adminReplyBy is string &&
              data.adminReplyBy.size() > 0 &&
              data.adminReplyBy.size() <= 128)
          );
    }

    function validHiddenBingoComment(data) {
      return data.keys().hasOnly([
            'user', 'text', 'createdAt', 'updatedAt',
            'adminLiked', 'adminLikedAt', 'adminLikedBy',
            'adminReply', 'adminReplyAt', 'adminReplyBy',
            'hiddenAt', 'hiddenBy'
          ]) &&
          data.keys().hasAll([
            'user', 'text', 'createdAt', 'updatedAt', 'hiddenAt', 'hiddenBy'
          ]) &&
          data.user is string && data.user.size() <= 128 &&
          data.text is string && data.text.size() > 0 &&
          data.text.size() <= 500 &&
          data.createdAt is timestamp &&
          data.updatedAt is timestamp &&
          data.hiddenAt is timestamp &&
          data.hiddenBy is string &&
          data.hiddenBy.size() > 0 &&
          data.hiddenBy.size() <= 128 &&
          (
            (!('adminLiked' in data) &&
              !('adminLikedAt' in data) &&
              !('adminLikedBy' in data)) ||
            (data.adminLiked == true &&
              data.adminLikedAt is timestamp &&
              data.adminLikedBy is string &&
              data.adminLikedBy.size() > 0 &&
              data.adminLikedBy.size() <= 128)
          ) &&
          (
            (!('adminReply' in data) &&
              !('adminReplyAt' in data) &&
              !('adminReplyBy' in data)) ||
            (data.adminReply is string &&
              data.adminReply.size() > 0 &&
              data.adminReply.size() <= 500 &&
              data.adminReplyAt is timestamp &&
              data.adminReplyBy is string &&
              data.adminReplyBy.size() > 0 &&
              data.adminReplyBy.size() <= 128)
          );
    }

    function validBingoCommentDocumentId(document, userId) {
      return document == userId ||
          document.matches(
            '^comment_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
          );
    }

    function validBingoCommentLike(data) {
      return data.keys().hasOnly(['createdAt']) &&
          data.keys().hasAll(['createdAt']) &&
          data.createdAt is timestamp;
    }

    function validYoutubeLink(data) {
      return data.keys().hasOnly(['date', 'caption', 'link', 'id', 'expiration']) &&
          optionalTimestamp(data, 'date') &&
          optionalString(data, 'caption', 2000) &&
          optionalString(data, 'link', 2048) &&
          optionalString(data, 'id', 256) &&
          optionalTimestamp(data, 'expiration');
    }

    function validSettings(data) {
      return data.keys().hasOnly(['betaFeatures']) &&
          optionalMap(data, 'betaFeatures');
    }

    function validPostText(data) {
      return data.keys().hasOnly(['date', 'expiration', 'text', 'link']) &&
          optionalTimestamp(data, 'date') &&
          optionalTimestamp(data, 'expiration') &&
          optionalString(data, 'text', 10000) &&
          optionalString(data, 'link', 2048);
    }

    // Additive customer-support contract. A member owns the conversation whose
    // document id is their Authentication uid. Member messages stay immutable;
    // administrators may correct or remove only messages sent by an admin.
    function validSupportMessage(data) {
      return data.keys().hasOnly([
            'sender_uid', 'sender_role', 'text', 'attachment_type',
            'created_at', 'edited_at'
          ]) &&
          data.keys().hasAll([
            'sender_uid', 'sender_role', 'text', 'created_at'
          ]) &&
          data.sender_uid is string && data.sender_uid.size() > 0 &&
          data.sender_uid.size() <= 128 &&
          data.sender_role in ['user', 'admin'] &&
          data.text is string && data.text.size() > 0 &&
          data.text.size() <= 1000 &&
          (!data.keys().hasAny(['attachment_type']) ||
            data.attachment_type in ['image', 'audio']) &&
          data.created_at is timestamp &&
          optionalTimestamp(data, 'edited_at');
    }

    function validSupportImageAttachment(data) {
      return data.keys().hasOnly([
            'base64', 'mime_type', 'byte_length'
          ]) &&
          data.keys().hasAll([
            'base64', 'mime_type', 'byte_length'
          ]) &&
          data.base64 is string && data.base64.size() > 0 &&
          data.base64.size() <= 800000 &&
          data.base64.matches('^[A-Za-z0-9+/]+={0,2}$') &&
          data.mime_type == 'image/jpeg' &&
          data.byte_length is int && data.byte_length > 0 &&
          data.byte_length <= 600000;
    }

    function validSupportAudioAttachment(data) {
      return data.keys().hasOnly(['base64', 'mime_type', 'byte_length', 'duration_ms']) &&
          data.keys().hasAll(['base64', 'mime_type', 'byte_length', 'duration_ms']) &&
          data.base64 is string && data.base64.size() > 0 &&
          data.base64.size() <= 640060 &&
          data.base64.matches('^[A-Za-z0-9+/]+={0,2}$') &&
          data.mime_type == 'audio/wav' &&
          data.byte_length is int && data.byte_length > 44 &&
          data.byte_length <= 480044 && data.byte_length % 2 == 0 &&
          data.base64.size() >= data.byte_length * 4 / 3 &&
          data.base64.size() < data.byte_length * 4 / 3 + 4 &&
          data.duration_ms is int && data.duration_ms > 0 &&
          data.duration_ms <= 30000 &&
          data.duration_ms <= (data.byte_length - 44) / 16 &&
          data.duration_ms > (data.byte_length - 44) / 16 - 1;
    }

    function supportImageMatchesMessage(userId, messageId, data) {
      return !data.keys().hasAny(['attachment_type']) ||
          (data.attachment_type == 'image' &&
            validSupportImageAttachment(getAfter(
              /databases/$(database)/documents/support_conversations/$(userId)/messages/$(messageId)/attachments/image
            ).data)) ||
          (data.attachment_type == 'audio' &&
            validSupportAudioAttachment(getAfter(
              /databases/$(database)/documents/support_conversations/$(userId)/messages/$(messageId)/attachments/audio
            ).data));
    }

    function validSupportConversation(data, userId) {
      return data.keys().hasOnly([
            'user_uid', 'user_email', 'user_display_name', 'topic', 'status',
            'created_at', 'updated_at', 'last_message', 'last_message_id',
            'last_sender_role'
          ]) &&
          data.keys().hasAll([
            'user_uid', 'topic', 'status', 'created_at', 'updated_at',
            'last_message', 'last_message_id', 'last_sender_role'
          ]) &&
          data.user_uid == userId &&
          optionalString(data, 'user_email', 320) &&
          optionalString(data, 'user_display_name', 256) &&
          data.topic == 'subscription' &&
          data.status in ['open', 'treated', 'deleting'] &&
          data.created_at is timestamp &&
          data.updated_at is timestamp &&
          data.last_message is string && data.last_message.size() > 0 &&
          data.last_message.size() <= 1000 &&
          data.last_message_id is string &&
          data.last_message_id.size() > 0 &&
          data.last_message_id.size() <= 128 &&
          data.last_sender_role in ['user', 'admin'];
    }

    function validGuestSupportId(guestId) {
      return guestId.matches(
        '^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
      );
    }

    function validGuestSupportConversation(data, guestId) {
      return data.keys().hasOnly([
            'user_uid', 'guest_access', 'topic', 'status', 'created_at',
            'updated_at', 'last_message', 'last_message_id',
            'last_sender_role'
          ]) &&
          data.keys().hasAll([
            'user_uid', 'guest_access', 'topic', 'status', 'created_at',
            'updated_at', 'last_message', 'last_message_id',
            'last_sender_role'
          ]) &&
          data.user_uid == guestId &&
          data.guest_access == true &&
          data.topic == 'subscription' &&
          data.status in ['open', 'treated', 'deleting'] &&
          data.created_at is timestamp &&
          data.updated_at is timestamp &&
          data.last_message is string && data.last_message.size() > 0 &&
          data.last_message.size() <= 1000 &&
          data.last_message_id is string &&
          data.last_message_id.size() > 0 &&
          data.last_message_id.size() <= 128 &&
          data.last_sender_role in ['user', 'admin'];
    }

    function supportSummaryMatchesMessage(userId, data, senderRole) {
      let message = getAfter(
        /databases/$(database)/documents/support_conversations/$(userId)/messages/$(data.last_message_id)
      ).data;
      return data.updated_at == request.time &&
          data.last_sender_role == senderRole &&
          message.sender_uid == request.auth.uid &&
          message.sender_role == senderRole &&
          message.text == data.last_message &&
          message.created_at == request.time;
    }

    function supportSummaryMatchesStoredMessage(userId, data) {
      let message = getAfter(
        /databases/$(database)/documents/support_conversations/$(userId)/messages/$(data.last_message_id)
      ).data;
      return data.updated_at == request.time &&
          message.text == data.last_message &&
          message.sender_role == data.last_sender_role &&
          validSupportMessage(message);
    }

    function guestSupportSummaryMatchesMessage(guestId, data) {
      let message = getAfter(
        /databases/$(database)/documents/support_conversations/$(guestId)/messages/$(data.last_message_id)
      ).data;
      return data.updated_at == request.time &&
          data.last_sender_role == 'user' &&
          message.sender_uid == guestId &&
          message.sender_role == 'user' &&
          message.text == data.last_message &&
          message.created_at == request.time;
    }

    function validWebPushToken(data, userId) {
      return data.keys().hasOnly([
            'token', 'userId', 'locale', 'createdAt', 'updatedAt'
          ]) &&
          data.token is string &&
          data.token.size() > 0 &&
          data.token.size() <= 2048 &&
          data.userId == userId &&
          data.locale is string &&
          data.locale in ['fr', 'en', 'cr'] &&
          data.createdAt is timestamp &&
          data.updatedAt is timestamp;
    }

    function validPaymentTransaction(data, documentId) {
      return data.keys().hasOnly([
            'user_ref',
            'user_uid',
            'user_email',
            'user_display_name',
            'user_code',
            'receipt_code',
            'transaction_type',
            'previous_end_sub',
            'new_end_sub',
            'payment_method',
            'amount',
            'currency',
            'member_time_before',
            'member_time_after',
            'created_at',
            'created_by',
            'created_by_email',
            'related_transaction_ref',
            'payment_cancelled',
            'cancellation_reason',
            'refunded_amount',
            'refund_currency'
          ]) &&
          data.keys().hasAll([
            'user_ref',
            'user_uid',
            'receipt_code',
            'member_time_before',
            'member_time_after',
            'created_at',
            'created_by'
          ]) &&
          data.user_ref is path &&
          data.user_uid is string && data.user_uid.size() > 0 &&
          data.user_uid.size() <= 128 &&
          data.user_ref ==
            /databases/$(database)/documents/user/$(data.user_uid) &&
          optionalString(data, 'user_email', 320) &&
          optionalString(data, 'user_display_name', 256) &&
          optionalString(data, 'user_code', 128) &&
          data.receipt_code is string &&
          data.receipt_code == 'CH-' + documentId &&
          (!('transaction_type' in data) ||
            data.transaction_type in [
              'subscription', 'renewal', 'adjustment', 'cancellation'
            ]) &&
          optionalTimestamp(data, 'previous_end_sub') &&
          (
            (
              'transaction_type' in data &&
              data.transaction_type == 'cancellation' &&
              !('new_end_sub' in data) &&
              data.payment_cancelled is bool &&
              data.cancellation_reason is string &&
              data.cancellation_reason.size() > 0 &&
              data.cancellation_reason.size() <= 500 &&
              (
                (
                  !('refunded_amount' in data) &&
                  !('refund_currency' in data)
                ) ||
                (
                  data.refunded_amount is number &&
                  data.refunded_amount >= 0 &&
                  data.refunded_amount <= 999999999.99 &&
                  data.refund_currency in ['USD', 'GDS']
                )
              ) &&
              !('amount' in data) &&
              !('currency' in data) &&
              (
                !('related_transaction_ref' in data) ||
                (
                  data.related_transaction_ref is path &&
                  exists(data.related_transaction_ref) &&
                  get(data.related_transaction_ref).data.user_uid ==
                    data.user_uid &&
                  (
                    !('transaction_type' in
                      get(data.related_transaction_ref).data) ||
                    get(data.related_transaction_ref).data.transaction_type !=
                      'cancellation'
                  )
                )
              ) &&
              (
                data.payment_cancelled == false ||
                'related_transaction_ref' in data
              )
            ) ||
            (
              (!('transaction_type' in data) ||
                data.transaction_type != 'cancellation') &&
              data.new_end_sub is timestamp &&
              !('related_transaction_ref' in data) &&
              !('payment_cancelled' in data) &&
              !('cancellation_reason' in data) &&
              !('refunded_amount' in data) &&
              !('refund_currency' in data)
            )
          ) &&
          (!('payment_method' in data) ||
            data.payment_method in [
              'moncash', 'cash', 'stripe', 'natcash', 'zelle', 'cashapp',
              'virement'
            ]) &&
          (
            (!('amount' in data) && !('currency' in data)) ||
            (
              data.amount is number && data.amount > 0 &&
              data.amount <= 999999999.99 &&
              data.currency in ['USD', 'GDS']
            )
          ) &&
          data.member_time_before is int && data.member_time_before >= 0 &&
          data.member_time_after is int &&
          (
            (
              !('transaction_type' in data) &&
              data.member_time_after == data.member_time_before + 1
            ) ||
            (
              data.transaction_type in ['adjustment', 'cancellation'] &&
              data.member_time_after == data.member_time_before
            ) ||
            (
              data.transaction_type in ['subscription', 'renewal'] &&
              data.member_time_after == data.member_time_before + 1
            )
          ) &&
          data.created_at is timestamp &&
          data.created_by is string && data.created_by.size() > 0 &&
          data.created_by.size() <= 128 &&
          optionalString(data, 'created_by_email', 320);
    }

    match /croix/{document} {
      allow read: if true;
      allow create: if isAdmin() && createsOwn('created_by') &&
          validCroix(request.resource.data);
      allow update: if isAdmin() && owns('created_by') && keepsOwner('created_by') &&
          validCroix(request.resource.data);
      allow delete: if isAdmin() && owns('created_by');
    }

    match /user/{userId} {
      // User ownership is derived from the document path, not resource.data.
      // This is important for first sign-in: released clients read /user/{uid}
      // before creating it, so there is no resource.data to inspect yet.
      // Some older clients omitted the uid field; accept that legacy shape while
      // still rejecting a uid that conflicts with the authenticated path owner.
      allow create: if signedIn() &&
          request.auth.uid == userId &&
          (!('uid' in request.resource.data) ||
            request.resource.data.uid == userId);
      allow read: if signedIn() &&
          (request.auth.uid == userId || isAdmin());
      allow update: if signedIn() &&
          (request.auth.uid == userId || isAdmin()) &&
          (!('uid' in request.resource.data) ||
            request.resource.data.uid == userId);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /user/{userId}/webPushTokens/{tokenId} {
      allow read: if signedIn() &&
          (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() &&
          request.auth.uid == userId &&
          validWebPushToken(request.resource.data, userId);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /prediction/{document} {
      // Released clients already gate the VIP screen locally using end_sub.
      // Keep authenticated prediction reads compatible with those clients;
      // this also avoids hiding the VIP content when a legacy profile does not
      // yet expose a normalized end_sub timestamp to rules.
      allow read: if signedIn();
      allow create: if isAdmin() && createsOwn('created_by') &&
          validPrediction(request.resource.data);
      allow update: if isAdmin() && owns('created_by') && keepsOwner('created_by') &&
          validPrediction(request.resource.data);
      allow delete: if isAdmin() && owns('created_by');
    }

    match /resultats/{document} {
      allow read: if true;
      allow create: if isAdmin() && createsOwn('created_by') &&
          validResultat(request.resource.data);
      allow update: if isAdmin() && owns('created_by') && keepsOwner('created_by') &&
          validResultat(request.resource.data);
      allow delete: if isAdmin() && owns('created_by');
    }

    match /prediction/{parent}/userStars/{document} {
      allow read: if true;
      // Preserved for released clients. New writes should move to a callable
      // function before this legacy authenticated path is retired.
      allow create: if false;
      allow update: if signedIn();
      allow delete: if false;
    }

    match /{path=**}/userStars/{document} {
      allow read: if true;
    }

    match /bingo/{document} {
      allow read: if true;
      // The released dashboard is authenticated and does not store an owner on
      // bingo documents, so authenticated publisher access remains compatible.
      allow create, update: if isAdmin() && validBingo(request.resource.data);
      allow delete: if isAdmin();
    }

    match /bingo/{parent}/bingostats/{document} {
      allow read: if true;
      allow create: if signedIn() && validBingoStats(request.resource.data) &&
          request.resource.data.user == request.auth.uid;
      allow update: if signedIn() && validBingoStats(request.resource.data) &&
          resource.data.user == request.auth.uid &&
          request.resource.data.user == resource.data.user;
      allow delete: if signedIn() && resource.data.user == request.auth.uid;
    }

    match /bingo/{parent}/comments/{document} {
      allow read: if true;
      allow create: if signedIn() &&
          validBingoCommentDocumentId(document, request.auth.uid) &&
          validBingoComment(request.resource.data) &&
          request.resource.data.keys().hasOnly([
            'user', 'text', 'createdAt', 'updatedAt'
          ]) &&
          request.resource.data.user == request.auth.uid;
      allow create: if isAdmin() && validBingoComment(request.resource.data);
      allow update: if signedIn() &&
          validBingoComment(request.resource.data) &&
          resource.data.user == request.auth.uid &&
          request.resource.data.user == resource.data.user &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'text', 'updatedAt'
          ]);
      allow update: if isAdmin() &&
          validBingoComment(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'adminLiked', 'adminLikedAt', 'adminLikedBy',
            'adminReply', 'adminReplyAt', 'adminReplyBy'
          ]);
      allow delete: if signedIn() &&
          (resource.data.user == request.auth.uid || isAdmin());
    }

    match /bingo/{parent}/hiddenComments/{document} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
          validHiddenBingoComment(request.resource.data) &&
          request.resource.data.hiddenBy == request.auth.uid;
      allow update: if isAdmin() &&
          validHiddenBingoComment(request.resource.data) &&
          request.resource.data.user == resource.data.user &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.hiddenAt == resource.data.hiddenAt &&
          request.resource.data.hiddenBy == resource.data.hiddenBy &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'adminLiked', 'adminLikedAt', 'adminLikedBy',
            'adminReply', 'adminReplyAt', 'adminReplyBy'
          ]);
      allow delete: if isAdmin();
    }

    match /bingo/{parent}/comments/{comment}/likes/{userId} {
      allow read: if true;
      allow create: if signedIn() && userId == request.auth.uid &&
          validBingoCommentLike(request.resource.data);
      allow update: if false;
      allow delete: if signedIn() && userId == request.auth.uid;
    }

    match /{path=**}/bingostats/{document} {
      allow read: if true;
    }

    match /youtubeLinks/{document} {
      allow read: if true;
      allow create: if isAdmin() && validYoutubeLink(request.resource.data);
      allow update, delete: if false;
    }

    // Public help content, published atomically by administrators only.
    match /support_bot/{document} {
      allow get: if document == 'config';
      allow list, delete: if false;
      allow create, update: if document == 'config' && isAdmin() &&
        request.resource.data.keys().hasOnly(['enabled', 'greeting', 'nodes', 'revision', 'paymentMethods', 'plans']) &&
        (!('paymentMethods' in request.resource.data) ||
          (request.resource.data.paymentMethods is list && request.resource.data.paymentMethods.size() <= 20)) &&
        (!('plans' in request.resource.data) ||
          (request.resource.data.plans is list && request.resource.data.plans.size() <= 30)) &&
        request.resource.data.enabled is bool &&
        request.resource.data.greeting is string &&
        request.resource.data.greeting.size() > 0 &&
        request.resource.data.greeting.size() <= 1000 &&
        request.resource.data.nodes is list &&
        request.resource.data.nodes.size() > 0 &&
        request.resource.data.nodes.size() <= 80 &&
        request.resource.data.revision is int &&
        ((!exists(/databases/$(database)/documents/support_bot/config) && request.resource.data.revision == 1) ||
          (exists(/databases/$(database)/documents/support_bot/config) && request.resource.data.revision == resource.data.revision + 1));
    }

    match /settings/{document} {
      allow read: if true;
      allow create: if isAdmin() && validSettings(request.resource.data);
      allow update, delete: if false;
    }

    match /postText/{document} {
      allow read: if true;
      allow create: if isAdmin() && validPostText(request.resource.data);
      allow update, delete: if false;
    }

    match /support_conversations/{userId} {
      // Reading an absent own conversation is part of the first-message flow;
      // ownership therefore comes from the path, never resource.data.
      allow get: if
          (signedIn() && (request.auth.uid == userId || isAdmin())) ||
          (request.auth == null && validGuestSupportId(userId) &&
            (!exists(
              /databases/$(database)/documents/support_conversations/$(userId)
            ) || resource.data.guest_access == true));
      allow list: if isAdmin();
      allow create: if
          (signedIn() && request.auth.uid == userId &&
            exists(/databases/$(database)/documents/user/$(userId)) &&
            validSupportConversation(request.resource.data, userId) &&
            request.resource.data.status == 'open' &&
            request.resource.data.created_at == request.time &&
            supportSummaryMatchesMessage(
              userId, request.resource.data, 'user'
            )) ||
          (request.auth == null && validGuestSupportId(userId) &&
            validGuestSupportConversation(request.resource.data, userId) &&
            request.resource.data.status == 'open' &&
            request.resource.data.created_at == request.time &&
            guestSupportSummaryMatchesMessage(
              userId, request.resource.data
            ));
      allow update: if signedIn() &&
          (validSupportConversation(request.resource.data, userId) ||
            validGuestSupportConversation(request.resource.data, userId)) &&
          request.resource.data.user_uid == resource.data.user_uid &&
          request.resource.data.topic == resource.data.topic &&
          request.resource.data.created_at == resource.data.created_at &&
          (
            (resource.data.status != 'deleting' &&
              request.resource.data.status == 'open' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'updated_at', 'last_message', 'last_message_id',
                'last_sender_role'
              ]) &&
              (
                (request.auth.uid == userId &&
                  supportSummaryMatchesMessage(
                    userId, request.resource.data, 'user'
                  )) ||
                (isAdmin() &&
                  supportSummaryMatchesMessage(
                    userId, request.resource.data, 'admin'
                  ))
              )) ||
            (isAdmin() &&
              request.resource.data.status in ['treated', 'deleting'] &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status'
              ])) ||
            (isAdmin() && resource.data.status != 'deleting' &&
              request.resource.data.status == resource.data.status &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'updated_at', 'last_message', 'last_message_id',
                'last_sender_role'
              ]) &&
              supportSummaryMatchesStoredMessage(
                userId, request.resource.data
              ))
          ) ||
          (request.auth == null && validGuestSupportId(userId) &&
            resource.data.guest_access == true &&
            validGuestSupportConversation(request.resource.data, userId) &&
            request.resource.data.user_uid == resource.data.user_uid &&
            request.resource.data.topic == resource.data.topic &&
            request.resource.data.created_at == resource.data.created_at &&
            resource.data.status != 'deleting' &&
            request.resource.data.status == 'open' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'updated_at', 'last_message', 'last_message_id',
              'last_sender_role'
            ]) &&
            guestSupportSummaryMatchesMessage(
              userId, request.resource.data
            ));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get: if
            (signedIn() && (request.auth.uid == userId || isAdmin())) ||
            (request.auth == null && validGuestSupportId(userId) &&
              (!exists(
                /databases/$(database)/documents/support_conversations/$(userId)/messages/$(messageId)
              ) || get(
                /databases/$(database)/documents/support_conversations/$(userId)
              ).data.guest_access == true));
        allow list: if
            (signedIn() && (request.auth.uid == userId || isAdmin())) ||
            (request.auth == null && validGuestSupportId(userId) &&
              (!exists(
                /databases/$(database)/documents/support_conversations/$(userId)
              ) || get(
                  /databases/$(database)/documents/support_conversations/$(userId)
                ).data.guest_access == true));
        allow create: if signedIn() &&
            validSupportMessage(request.resource.data) &&
            !request.resource.data.keys().hasAny(['edited_at']) &&
            supportImageMatchesMessage(
              userId, messageId, request.resource.data
            ) &&
            request.resource.data.created_at == request.time &&
            getAfter(
              /databases/$(database)/documents/support_conversations/$(userId)
            ).data.last_message_id == messageId &&
            getAfter(
              /databases/$(database)/documents/support_conversations/$(userId)
            ).data.last_message == request.resource.data.text &&
            getAfter(
              /databases/$(database)/documents/support_conversations/$(userId)
            ).data.updated_at == request.time &&
            (
              (request.auth.uid == userId &&
                request.resource.data.sender_uid == request.auth.uid &&
                request.resource.data.sender_role == 'user') ||
              (isAdmin() &&
                request.resource.data.sender_uid == request.auth.uid &&
                request.resource.data.sender_role == 'admin')
            ) ||
            (request.auth == null && validGuestSupportId(userId) &&
              validSupportMessage(request.resource.data) &&
              !request.resource.data.keys().hasAny(['edited_at']) &&
              supportImageMatchesMessage(
                userId, messageId, request.resource.data
              ) &&
              request.resource.data.created_at == request.time &&
              request.resource.data.sender_uid == userId &&
              request.resource.data.sender_role == 'user' &&
              getAfter(
                /databases/$(database)/documents/support_conversations/$(userId)
              ).data.guest_access == true &&
              getAfter(
                /databases/$(database)/documents/support_conversations/$(userId)
              ).data.last_message_id == messageId &&
              getAfter(
                /databases/$(database)/documents/support_conversations/$(userId)
              ).data.last_message == request.resource.data.text &&
              getAfter(
                /databases/$(database)/documents/support_conversations/$(userId)
              ).data.updated_at == request.time);
        allow update: if isAdmin() &&
            resource.data.sender_role == 'admin' &&
            validSupportMessage(request.resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text', 'edited_at'
            ]) &&
            request.resource.data.edited_at == request.time &&
            (
              getAfter(
                /databases/$(database)/documents/support_conversations/$(userId)
              ).data.last_message_id != messageId ||
              (
                getAfter(
                  /databases/$(database)/documents/support_conversations/$(userId)
                ).data.last_message == request.resource.data.text &&
                getAfter(
                  /databases/$(database)/documents/support_conversations/$(userId)
                ).data.updated_at == request.time
              )
            );
        allow delete: if isAdmin() &&
            (
              get(
                /databases/$(database)/documents/support_conversations/$(userId)
              ).data.status == 'deleting' ||
              getAfter(
                /databases/$(database)/documents/support_conversations/$(userId)
              ).data.last_message_id != messageId
            );

        match /attachments/{attachmentId} {
          allow get: if
              (signedIn() && (request.auth.uid == userId || isAdmin())) ||
              (request.auth == null && validGuestSupportId(userId) &&
                get(
                  /databases/$(database)/documents/support_conversations/$(userId)
                ).data.guest_access == true);
          // The guest transaction reads the absent audio before its first write.
          allow get: if attachmentId == 'audio' && request.auth == null &&
              validGuestSupportId(userId) && !exists(
                /databases/$(database)/documents/support_conversations/$(userId)
              );
          allow create: if (
                (attachmentId == 'image' && validSupportImageAttachment(request.resource.data)) ||
                (attachmentId == 'audio' && validSupportAudioAttachment(request.resource.data) &&
                  !exists(/databases/$(database)/documents/support_conversations/$(userId)/messages/$(messageId)))
              ) &&
              getAfter(
                /databases/$(database)/documents/support_conversations/$(userId)/messages/$(messageId)
              ).data.attachment_type == attachmentId &&
              (
                (signedIn() &&
                  getAfter(
                    /databases/$(database)/documents/support_conversations/$(userId)/messages/$(messageId)
                  ).data.sender_uid == request.auth.uid &&
                  (
                    (request.auth.uid == userId &&
                      getAfter(
                        /databases/$(database)/documents/support_conversations/$(userId)/messages/$(messageId)
                      ).data.sender_role == 'user') ||
                    (isAdmin() &&
                      getAfter(
                        /databases/$(database)/documents/support_conversations/$(userId)/messages/$(messageId)
                      ).data.sender_role == 'admin')
                  )) ||
                (request.auth == null && validGuestSupportId(userId) &&
                  getAfter(
                    /databases/$(database)/documents/support_conversations/$(userId)
                  ).data.guest_access == true &&
                  getAfter(
                    /databases/$(database)/documents/support_conversations/$(userId)/messages/$(messageId)
                  ).data.sender_uid == userId &&
                  getAfter(
                    /databases/$(database)/documents/support_conversations/$(userId)/messages/$(messageId)
                  ).data.sender_role == 'user')
              );
          allow list, update: if false;
          allow delete: if isAdmin();
        }
      }
    }

    // Additive payment-proof flow. Published user/payment contracts stay intact.
    function validPaymentRequest(data) {
      return data.keys().hasOnly([
          'user_uid', 'plan', 'status', 'amount', 'currency', 'payment_method',
          'payment_reference', 'note', 'created_at'
        ]) && data.keys().hasAll([
          'user_uid', 'plan', 'status', 'note', 'created_at'
        ]) && data.user_uid == request.auth.uid && data.plan == 'vip' &&
        data.status == 'pending' &&
        (!data.keys().hasAny(['amount', 'currency', 'payment_method', 'payment_reference']) ||
          (validConfirmedPayment(data) && data.payment_reference is string &&
            data.payment_reference.size() > 0 && data.payment_reference.size() <= 128)) &&
        data.note is string && data.note.size() <= 500 &&
        data.created_at == request.time;
    }

    function validConfirmedPayment(data) {
      return data.amount is number && data.amount > 0 && data.amount <= 999999999.99 &&
        data.currency in ['GDS', 'USD'] &&
        data.payment_method in ['moncash', 'natcash', 'zelle', 'cashapp', 'virement', 'cash', 'stripe'];
    }

    function validPaymentApproval(id, data) {
      let receiptPath = /databases/$(database)/documents/payment_transactions/$('proof_' + id);
      let profilePath = /databases/$(database)/documents/user/$(resource.data.user_uid);
      let receipt = getAfter(receiptPath).data;
      let before = get(profilePath).data;
      let after = getAfter(profilePath).data;
      return data.status == 'approved' && validConfirmedPayment(data) &&
        data.transaction_id == 'proof_' + id &&
        data.new_end_sub is timestamp && data.new_end_sub > request.time &&
        (!('end_sub' in before) || !(before.end_sub is timestamp) ||
          data.new_end_sub > before.end_sub) &&
        !exists(receiptPath) &&
        receipt.user_uid == resource.data.user_uid &&
        receipt.amount == data.amount &&
        receipt.currency == data.currency &&
        receipt.payment_method == data.payment_method &&
        receipt.transaction_type in ['subscription', 'renewal'] &&
        receipt.new_end_sub == data.new_end_sub &&
        receipt.created_at == request.time && receipt.created_by == request.auth.uid &&
        receipt.member_time_before == ('member_time' in before ? before.member_time : 0) &&
        receipt.member_time_after == receipt.member_time_before + 1 &&
        after.member_time == receipt.member_time_after &&
        after.end_sub == data.new_end_sub && after.method == data.payment_method &&
        after.updated_time == request.time;
    }

    match /payment_requests/{id} {
      // Transactions read an absent request before creating it. No private data
      // is exposed by permitting the missing-document result to signed-in users.
      allow get: if signedIn() &&
        (!exists(/databases/$(database)/documents/payment_requests/$(id)) ||
          resource.data.user_uid == request.auth.uid || isAdmin());
      allow list: if signedIn() &&
        (resource.data.user_uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && validPaymentRequest(request.resource.data) &&
        exists(/databases/$(database)/documents/user/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/payment_requests/$(id)/evidence/image).data.mime_type == 'image/jpeg';
      allow update: if isAdmin() && resource.data.status == 'pending' &&
        request.resource.data.reviewed_by == request.auth.uid &&
        request.resource.data.reviewed_at == request.time &&
        (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'reviewed_by', 'reviewed_at', 'transaction_id', 'new_end_sub',
              'amount', 'currency', 'payment_method'
            ]) && validPaymentApproval(id, request.resource.data)) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'reviewed_by', 'reviewed_at', 'rejection_reason'
            ]) && request.resource.data.status == 'rejected' &&
            request.resource.data.rejection_reason is string &&
            request.resource.data.rejection_reason.size() > 0 &&
            request.resource.data.rejection_reason.size() <= 500)
        );
      allow delete: if false;

      match /evidence/{imageId} {
        allow get: if signedIn() && (isAdmin() ||
          get(/databases/$(database)/documents/payment_requests/$(id)).data.user_uid == request.auth.uid);
        allow create: if signedIn() && imageId == 'image' &&
          !exists(/databases/$(database)/documents/payment_requests/$(id)) &&
          getAfter(/databases/$(database)/documents/payment_requests/$(id)).data.user_uid == request.auth.uid &&
          request.resource.data.keys().hasOnly(['base64', 'mime_type', 'byte_length']) &&
          request.resource.data.mime_type == 'image/jpeg' &&
          request.resource.data.byte_length is int && request.resource.data.byte_length > 0 &&
          request.resource.data.byte_length <= 600000 &&
          request.resource.data.base64 is string &&
          request.resource.data.base64.size() > 0 && request.resource.data.base64.size() <= 800000 &&
          request.resource.data.base64.matches('^[A-Za-z0-9+/]+={0,2}$');
        allow list, update, delete: if false;
      }
    }

    match /payment_transactions/{document} {
      allow read: if signedIn() &&
          (isAdmin() || resource.data.user_uid == request.auth.uid);
      allow create: if isAdmin() &&
          request.resource.data.created_by == request.auth.uid &&
          request.resource.data.created_at == request.time &&
          validPaymentTransaction(request.resource.data, document);
      allow update, delete: if false;
    }
  }
}
