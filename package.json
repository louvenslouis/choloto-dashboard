{
  "name": "choloto-dashboard",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "results": "node tools/fetch_new_york_results.mjs public/data/official-new-york-results.json && node tools/fetch_additional_lottery_results.mjs public/data/official-additional-lottery-results.json",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e index.html vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
